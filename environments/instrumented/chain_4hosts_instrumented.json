{
 "name": "chain_4hosts_instrumented",
 "networks": [
  {
   "name": "chain_4hosts_instrumented_network",
   "description": "Chain of 25 hosts (instrumented: sysflow + Falco on every non-attacker host)",
   "subnets": [
    {
     "name": "ring_subnet",
     "cidr": "192.168.200.0/24",
     "dns_servers": [
      "8.8.8.8"
     ],
     "hosts": [
      {
       "name": "host0",
       "vm_type": "ubuntu_base_instrumented",
       "flavor": "m1.small",
       "ip_address": "192.168.200.10"
      },
      {
       "name": "host1",
       "vm_type": "ubuntu_base_instrumented",
       "flavor": "m1.small",
       "ip_address": "192.168.200.11"
      },
      {
       "name": "host2",
       "vm_type": "ubuntu_base_instrumented",
       "flavor": "m1.small",
       "ip_address": "192.168.200.12"
      },
      {
       "name": "host3",
       "vm_type": "ubuntu_base_instrumented",
       "flavor": "m1.small",
       "ip_address": "192.168.200.13"
      }
     ]
    },
    {
     "name": "attacker_subnet",
     "cidr": "192.168.202.0/24",
     "dns_servers": [
      "8.8.8.8"
     ],
     "hosts": [
      {
       "name": "attacker",
       "vm_type": "kali_running",
       "flavor": "m2.large",
       "ip_address": "192.168.202.100"
      }
     ]
    },
    {
     "name": "defender_subnet",
     "cidr": "192.168.250.0/24",
     "dns_servers": [
      "8.8.8.8"
     ],
     "hosts": [
      {
       "name": "defender",
       "vm_type": "ubuntu_base_running",
       "flavor": "m2.huge",
       "ip_address": "192.168.250.10"
      }
     ]
    }
   ]
  }
 ],
 "subnet_connections": [
  {
   "from_subnet": "ring_subnet",
   "to_subnet": "attacker_subnet",
   "protocol": null,
   "ports": null,
   "bidirectional": true
  }
 ],
 "playbooks": [
  {
   "name": "setup_ssh_keys",
   "args": {
    "host": "attacker",
    "host_user": "root",
    "followers": [
     {
      "follower": "host0",
      "follower_user": "ubuntu"
     }
    ]
   }
  },
  {
   "name": "setup_ssh_keys",
   "args": {
    "host": "host0",
    "host_user": "ubuntu",
    "followers": [
     {
      "follower": "host1",
      "follower_user": "ubuntu"
     }
    ]
   }
  },
  {
   "name": "setup_ssh_keys",
   "args": {
    "host": "host1",
    "host_user": "ubuntu",
    "followers": [
     {
      "follower": "host2",
      "follower_user": "ubuntu"
     }
    ]
   }
  },
  {
   "name": "setup_ssh_keys",
   "args": {
    "host": "host2",
    "host_user": "ubuntu",
    "followers": [
     {
      "follower": "host3",
      "follower_user": "ubuntu"
     }
    ]
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "host0",
    "host_user": "ubuntu",
    "path": "~/data_host0.json"
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "host1",
    "host_user": "ubuntu",
    "path": "~/data_host1.json"
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "host2",
    "host_user": "ubuntu",
    "path": "~/data_host2.json"
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "host3",
    "host_user": "ubuntu",
    "path": "~/data_host3.json"
   }
  }
 ]
}
