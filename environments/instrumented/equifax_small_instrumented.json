{
 "name": "equifax_small_instrumented",
 "networks": [
  {
   "name": "equifax_small_instrumented_network",
   "description": "Equifax-inspired instrumented: 2 webservers, 4 databases, 1 multihomed sensor (Zeek+Suricata), 1 attacker",
   "subnets": [
    {
     "name": "webserver_subnet",
     "cidr": "192.168.200.0/24",
     "dns_servers": [
      "8.8.8.8"
     ],
     "hosts": [
      {
       "name": "webserver_0",
       "vm_type": "webserver_instrumented",
       "flavor": "m1.small",
       "ip_address": "192.168.200.10"
      },
      {
       "name": "webserver_1",
       "vm_type": "webserver_instrumented",
       "flavor": "m1.small",
       "ip_address": "192.168.200.11"
      },
      {
       "name": "sensor",
       "vm_type": "sensor_instrumented",
       "flavor": "m1.medium",
       "ip_address": "192.168.200.20"
      }
     ]
    },
    {
     "name": "corporate_subnet",
     "cidr": "192.168.201.0/24",
     "dns_servers": [
      "8.8.8.8"
     ],
     "hosts": [
      {
       "name": "database_0",
       "vm_type": "ubuntu_base_instrumented",
       "flavor": "m1.small",
       "ip_address": "192.168.201.50"
      },
      {
       "name": "database_1",
       "vm_type": "ubuntu_base_instrumented",
       "flavor": "m1.small",
       "ip_address": "192.168.201.51"
      },
      {
       "name": "database_2",
       "vm_type": "ubuntu_base_instrumented",
       "flavor": "m1.small",
       "ip_address": "192.168.201.52"
      },
      {
       "name": "database_3",
       "vm_type": "ubuntu_base_instrumented",
       "flavor": "m1.small",
       "ip_address": "192.168.201.53"
      },
      {
       "name": "sensor",
       "vm_type": "sensor_instrumented",
       "flavor": "m1.medium",
       "ip_address": "192.168.201.20"
      }
     ]
    },
    {
     "name": "attacker_subnet",
     "cidr": "192.168.202.0/24",
     "dns_servers": [
      "8.8.8.8"
     ],
     "hosts": [
      {
       "name": "attacker",
       "vm_type": "kali_running",
       "flavor": "m2.large",
       "ip_address": "192.168.202.100"
      },
      {
       "name": "sensor",
       "vm_type": "sensor_instrumented",
       "flavor": "m1.medium",
       "ip_address": "192.168.202.20"
      }
     ]
    }
   ]
  }
 ],
 "subnet_connections": [
  {
   "from_subnet": "webserver_subnet",
   "to_subnet": "corporate_subnet",
   "protocol": null,
   "ports": null,
   "bidirectional": true
  },
  {
   "from_subnet": "webserver_subnet",
   "to_subnet": "attacker_subnet",
   "protocol": null,
   "ports": null,
   "bidirectional": true
  }
 ],
 "playbooks": [
  {
   "name": "setup_ssh_keys",
   "args": {
    "host": "webserver_0",
    "host_user": "tomcat",
    "followers": [
     {
      "follower": "database_0",
      "follower_user": "ubuntu"
     },
     {
      "follower": "database_1",
      "follower_user": "ubuntu"
     },
     {
      "follower": "database_2",
      "follower_user": "ubuntu"
     },
     {
      "follower": "database_3",
      "follower_user": "ubuntu"
     }
    ]
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "database_0",
    "host_user": "ubuntu",
    "path": "~/data_database_0.json"
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "database_1",
    "host_user": "ubuntu",
    "path": "~/data_database_1.json"
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "database_2",
    "host_user": "ubuntu",
    "path": "~/data_database_2.json"
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "database_3",
    "host_user": "ubuntu",
    "path": "~/data_database_3.json"
   }
  }
 ]
}