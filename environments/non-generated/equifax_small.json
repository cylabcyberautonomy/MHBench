{
 "name": "equifax_small",
 "networks": [
  {
   "name": "equifax_small_network",
   "description": "Equifax-inspired: 2 webservers, 4 databases",
   "subnets": [
    {
     "name": "webserver_subnet",
     "cidr": "192.168.200.0/24",
     "dns_servers": [
      "8.8.8.8"
     ],
     "hosts": [
      {
       "name": "webserver0",
       "vm_type": "webserver_running",
       "flavor": "m1.small",
       "ip_address": "192.168.200.10"
      },
      {
       "name": "webserver1",
       "vm_type": "webserver_running",
       "flavor": "m1.small",
       "ip_address": "192.168.200.11"
      }
     ]
    },
    {
     "name": "corporate_subnet",
     "cidr": "192.168.201.0/24",
     "dns_servers": [
      "8.8.8.8"
     ],
     "hosts": [
      {
       "name": "database0",
       "vm_type": "ubuntu_base_running",
       "flavor": "m1.small",
       "ip_address": "192.168.201.50"
      },
      {
       "name": "database1",
       "vm_type": "ubuntu_base_running",
       "flavor": "m1.small",
       "ip_address": "192.168.201.51"
      },
      {
       "name": "database2",
       "vm_type": "ubuntu_base_running",
       "flavor": "m1.small",
       "ip_address": "192.168.201.52"
      },
      {
       "name": "database3",
       "vm_type": "ubuntu_base_running",
       "flavor": "m1.small",
       "ip_address": "192.168.201.53"
      }
     ]
    },
    {
     "name": "attacker_subnet",
     "cidr": "192.168.202.0/24",
     "dns_servers": [
      "8.8.8.8"
     ],
     "hosts": [
      {
       "name": "attacker",
       "vm_type": "kali_running",
       "flavor": "m2.large",
       "ip_address": "192.168.202.100"
      }
     ]
    }
   ]
  }
 ],
 "subnet_connections": [
  {
   "from_subnet": "webserver_subnet",
   "to_subnet": "corporate_subnet",
   "protocol": null,
   "ports": null,
   "bidirectional": true
  },
  {
   "from_subnet": "webserver_subnet",
   "to_subnet": "attacker_subnet",
   "protocol": null,
   "ports": null,
   "bidirectional": true
  }
 ],
 "playbooks": [
  {
   "name": "setup_ssh_keys",
   "args": {
    "host": "webserver0",
    "host_user": "tomcat",
    "followers": [
     {
      "follower": "database0",
      "follower_user": "ubuntu"
     },
     {
      "follower": "database1",
      "follower_user": "ubuntu"
     },
     {
      "follower": "database2",
      "follower_user": "ubuntu"
     },
     {
      "follower": "database3",
      "follower_user": "ubuntu"
     }
    ]
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "database0",
    "host_user": "ubuntu",
    "path": "~/data_database0.json"
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "database1",
    "host_user": "ubuntu",
    "path": "~/data_database1.json"
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "database2",
    "host_user": "ubuntu",
    "path": "~/data_database2.json"
   }
  },
  {
   "name": "add_data",
   "args": {
    "host": "database3",
    "host_user": "ubuntu",
    "path": "~/data_database3.json"
   }
  }
 ]
}